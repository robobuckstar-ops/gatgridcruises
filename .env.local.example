# ============================================
# GatGridCruises.com — Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to source control.

# --- Supabase (Required for production) ---
# Get these from: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# --- Email (Required for newsletter) ---
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_abc123...

# --- Brevo (Optional — contact list management) ---
# Get from: https://app.brevo.com/settings/keys/api
# If set, new subscribers are added to Brevo as contacts.
BREVO_API_KEY=
# Optional: Brevo list ID to add contacts to (leave blank for no list)
BREVO_LIST_ID=

# --- Affiliate IDs (Required for monetization) ---
# Skyscanner: https://partners.skyscanner.net
SKYSCANNER_API_KEY=
# Booking.com: https://www.booking.com/affiliate-program
BOOKING_AFFILIATE_ID=
# Expedia: https://www.expediapartnersolutions.com
EXPEDIA_AFFILIATE_ID=

# --- Advertising ---
# Google AdSense: https://www.google.com/adsense
GOOGLE_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# --- Analytics ---
# Google Analytics 4 Measurement ID: https://analytics.google.com → Admin → Data Streams
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Site Config ---
NEXT_PUBLIC_SITE_URL=https://gatgridcruises.com
ADMIN_ALLOWED_EMAILS=robobuckstar@gmail.com

# --- Cron Jobs (Vercel) ---
# Generate a random secret: openssl rand -hex 32
CRON_SECRET=

# --- Concierge Inquiry Form ---
# Make.com webhook URL that receives /concierge form submissions.
# Server-side proxy at /api/concierge applies rate limiting, honeypot check,
# and input sanitization before forwarding here.
CONCIERGE_WEBHOOK_URL=

# --- Airtable (client portal, newsletter list, leads CRM) ---
# Airtable base/table IDs are hardcoded in src/lib/portal-airtable.ts.
# AIRTABLE_API_KEY: personal access token needing
#   data.records:read + data.records:write on base applSFcQkOus2fFsx
#   (bookings, clients, Subscribers, GatGrid Leads, Referrals).
#   Get from: https://airtable.com/create/tokens
# PORTAL_JWT_SECRET: signs portal session cookies (HMAC-SHA256, 7-day TTL).
#   Generate: openssl rand -base64 32
AIRTABLE_API_KEY=
PORTAL_JWT_SECRET=

# Newsletter / deal-alert subscribers are persisted to this table.
# Defaults to "Subscribers"; set this only if the table is named something else.
# Required columns are documented in docs/NEWSLETTER-SETUP.md.
AIRTABLE_SUBSCRIBERS_TABLE=

# Pipeline Stage applied to leads written by the inquiry/concierge forms.
# Defaults to "New Lead". Must NOT be one of the stages /api/cron/lead-nurture
# excludes (Converted, Lost, Unsubscribed, Ready to Book) or the nurture drip
# will skip the lead.
AIRTABLE_LEAD_NEW_STAGE=

# Field NAME (not ID) of the email column in the GatGrid Leads table, used to
# build the dedupe filterByFormula. Defaults to "Email". Set this only if that
# column has been renamed — a wrong name makes every lookup 422, which now
# degrades to "create a possibly-duplicate row" rather than dropping the lead.
AIRTABLE_LEAD_EMAIL_FIELD=

# --- Internal lead alerts ---
# Comma-separated recipients for the "new lead" notification emails. INTERNAL
# ONLY — this never appears in customer-facing mail, which always sends from
# and replies to bookings@gatgridcruises.com.
# Defaults to robobuckstar@gmail.com,bookings@gatgridcruises.com so alerts reach
# a phone-alerted inbox without any env config. Set to override.
AGENT_NOTIFY_EMAILS=
